<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VersaHUD.Controls.InitMasterPassword">
    <Border BackgroundColor="#1E1E1E" 
            Stroke="#2D2D2D"
            StrokeThickness="1"
            Margin="30" 
            VerticalOptions="Center" 
            HorizontalOptions="Fill">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="15"/>
        </Border.StrokeShape>

        <VerticalStackLayout Spacing="15" Padding="20">
            <Label Text="SECURE COCKPIT CORES" 
                   TextColor="#FFFFFF" 
                   FontSize="18" 
                   FontAttributes="Bold" 
                   HorizontalOptions="Center" 
                   CharacterSpacing="1"/>

            <Label Text="Establish your initial Master Passcode. This key encrypts all automated Lock, Unlock, and Admin communications to your vehicle." 
                   TextColor="#8E8E93" 
                   FontSize="13" 
                   HorizontalOptions="Center" 
                   HorizontalTextAlignment="Center"/>

            <Entry x:Name="entryInitialPass" 
                   Placeholder="Enter Master Passcode" 
                   PlaceholderColor="#555555"
                   TextColor="#FFFFFF" 
                   BackgroundColor="#2D2D2D" 
                   IsPassword="True"
                   HeightRequest="48"
                   HorizontalTextAlignment="Center"/>

            <Button Text="🔒 INITIALIZE VAULT REGISTERS" 
                    BackgroundColor="#10B981" 
                    TextColor="#FFFFFF" 
                    FontAttributes="Bold"
                    Clicked="OnInitializePasswordClicked" 
                    CornerRadius="8" 
                    HeightRequest="50"/>

            <Button Text="🔌 WRONG DEVICE? CLEAR LINK &amp; RE-SCAN" 
                    BackgroundColor="Transparent" 
                    TextColor="#EF4444" 
                    FontSize="12"
                    FontAttributes="Bold"
                    Clicked="OnWrongDeviceClicked" 
                    HeightRequest="35"
                    Margin="0,5,0,0"/>
        </VerticalStackLayout>
    </Border>
</ContentView>
