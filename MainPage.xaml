<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:VersaHUD.Controls"
             x:Class="VersaHUD.MainPage"
             x:Name="mainPage"
             BackgroundColor="#121212">

    <Grid RowDefinitions="*, Auto" Margin="0" Padding="0" BindingContext="{x:Reference mainPage}">
        <ScrollView Grid.Row="0" VerticalOptions="Fill">
            <VerticalStackLayout Padding="20,10,20,10" Spacing="15" VerticalOptions="Start">
                <HorizontalStackLayout Spacing="8" HorizontalOptions="Center" VerticalOptions="Center">
                    <Label Text="{Binding CloudWanTelemetryStatusTextLabel}"
                           FontAttributes="Bold"
                           TextColor="{Binding CloudWanTelemetryStatusTextColor}" 
                           HorizontalOptions="Center" 
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
                <AbsoluteLayout HorizontalOptions="Fill" 
                    HeightRequest="170"
                    Margin="10,15,10,-70"
                    BackgroundColor="Transparent">

                    <Image Source="versahud_cockpit_badge.png"
                       AbsoluteLayout.LayoutBounds="0.4, -3, 200, 160"
                       AbsoluteLayout.LayoutFlags="PositionProportional"
                       Aspect="AspectFit"/>

                    <Button
                        IsEnabled="{Binding AdminNavigationButtonEnabled}"
                        Text="SETUP"
                        Clicked="OnAdminNavigationClicked"
                        AbsoluteLayout.LayoutBounds="1.05, -0.05, 75, 36"
                        AbsoluteLayout.LayoutFlags="PositionProportional"
                        FontSize="11"
                        FontAttributes="Bold"
                        CornerRadius="4"
                        BackgroundColor="#2A2A2D"
                        TextColor="White"/>
                </AbsoluteLayout>
                
                <controls:MemoryIndicator />
                
                <BoxView HeightRequest="1.5" BackgroundColor="#2D2D2D" Margin="0,2,0,5" />

                <Border BackgroundColor="{Binding BorderBluetoothStatusBackgroundColor}"
                        Stroke="{Binding BorderBluetoothStatusStrokeColor}" 
                        StrokeThickness="1" 
                        Margin="0,2" 
                        Padding="10,0"
                        HorizontalOptions="Center"
                        WidthRequest="340">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20"/>
                    </Border.StrokeShape>

                    <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="8" HorizontalOptions="Fill">
                        <Label Grid.Column="0" Text="{Binding DotTextLabel}" FontSize="14" VerticalOptions="Center"/>

                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                            <Label Text="{Binding BluetoothStatusTextLabel}" 
                                   TextColor="{Binding BluetoothStatusTextLabelColor}" 
                                   FontSize="11" 
                                   FontAttributes="Bold" 
                                   CharacterSpacing="0.5"/>

                            <Label Text="{Binding ActiveTransportChannelTextLabel}" 
                                   TextColor="#8E8E93" 
                                   FontSize="9" 
                                   FontAttributes="Bold" 
                                   CharacterSpacing="0.5"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="2" 
                                             VerticalOptions="Start" 
                                             HorizontalOptions="End" 
                                             Padding="0,6,0,0">

                            <Label Text="{Binding BluetoothSignalTextLabel}" 
                                   TextColor="{Binding BluetoothSignalTextLabelColor}"
                                   FontSize="11" 
                                   FontAttributes="Bold" 
                                   HorizontalTextAlignment="End"
                                   IsVisible="False"
                                   Margin="0,12,0,0"/>

                            <Button Text="🔄 CHANGE" 
                                    FontSize="9" 
                                    FontAttributes="Bold" 
                                    TextColor="#3B82F6" 
                                    BackgroundColor="Transparent" 
                                    BorderColor="Transparent" 
                                    BorderWidth="0" 
                                    Padding="5,0" 
                                    HeightRequest="30" 
                                    HorizontalOptions="End"
                                    IsVisible="{Binding ManualScanButtonVisible}" 
                                    Clicked="OnManualScanTriggerClicked" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <Border IsVisible="{Binding BorderNetworkStatusVisible}"
                        BackgroundColor="#1A242D" 
                        Stroke="#3B82F6" 
                        StrokeThickness="1" 
                        Margin="0,4,0,2" 
                        Padding="14,6"
                        HorizontalOptions="Center"
                        WidthRequest="340">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20"/>
                    </Border.StrokeShape>

                    <HorizontalStackLayout Spacing="8" HorizontalOptions="Center" VerticalOptions="Center">
                        <Label Text="🌐" FontSize="12" VerticalOptions="Center"/>
                        <Label Text="STATION IP:" TextColor="#8E8E93" FontSize="11" FontAttributes="Bold" VerticalOptions="Center"/>
                        <Label Text="{Binding VehicleIPTextLabel}" 
                               TextColor="#3B82F6" 
                               FontSize="12" 
                               FontAttributes="Bold" 
                               CharacterSpacing="0.5"
                               VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>

                <VerticalStackLayout Grid.Column="0" Spacing="10" HorizontalOptions="Center" IsVisible="{Binding LayoutReconnectingVisible}" Grid.ColumnSpan="2">
                    <Label Text="{Binding ReconnectingTextLabel}" FontSize="16" VerticalOptions="Center"/>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="0" Spacing="10" HorizontalOptions="Center" Grid.ColumnSpan="2" IsVisible="{Binding CrossChargeStatusLayoutVisible}">
                    <Label Text="{Binding CrossChargeStatusTextLabel}" TextColor="{Binding CrossChargeStatusTextLabelColorValue}" FontSize="16" VerticalOptions="Center"/>
                </VerticalStackLayout>
                
                <Grid ColumnDefinitions="*, *" Margin="0,15,0,0">
                    <VerticalStackLayout Grid.Column="0" Spacing="10" HorizontalOptions="Center">
                        <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                            <Label Text="{Binding FrontIconTextLabel}" FontSize="28" VerticalOptions="Center"/>
                            <Label Text="{Binding FrontPercentTextLabel}" TextColor="#FFFFFF" FontSize="24" FontAttributes="Bold" VerticalOptions="Center"/>
                        </HorizontalStackLayout>

                        <ProgressBar Progress="{Binding ProgressFrontValue}" ProgressColor="{Binding ProgressFrontColorValueProperty}" BackgroundColor="#2D2D2D" WidthRequest="130" HeightRequest="10"/>

                        <Label Text="FRONT BATTERY" TextColor="#8E8E93" FontSize="11" FontAttributes="Bold" HorizontalOptions="Center" CharacterSpacing="1"/>
                        <Label Text="{Binding FrontVoltsTextLabel}" TextColor="{Binding FrontVoltsTextLabelColorProperty}" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Column="1" Spacing="10" HorizontalOptions="Center">
                        <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                            <Label Text="{Binding BackIconTextLabel}" FontSize="28" VerticalOptions="Center"/>
                            <Label Text="{Binding FrontPercentTextLabel}" TextColor="#FFFFFF" FontSize="24" FontAttributes="Bold" VerticalOptions="Center"/>
                        </HorizontalStackLayout>

                        <ProgressBar Progress="{Binding ProgressBackValue}" ProgressColor="{Binding ProgressBackColorValueProperty}" BackgroundColor="#2D2D2D" WidthRequest="130" HeightRequest="10"/>

                        <Label Text="BACK BATTERY" TextColor="#8E8E93" FontSize="11" FontAttributes="Bold" HorizontalOptions="Center" CharacterSpacing="1"/>
                        <Label Text="{Binding BackVoltsTextLabel}" TextColor="{Binding BackVoltsTextLabelColorProperty}" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center"/>
                    </VerticalStackLayout>                   
                </Grid>

                <BoxView HeightRequest="2" BackgroundColor="#2D2D2D" Margin="0,10" />
            </VerticalStackLayout>
        </ScrollView>

        <Border Grid.Row="1" 
                BackgroundColor="#121212" 
                StrokeThickness="0" 
                Padding="20,15,20,25" 
                VerticalOptions="End">
            <Grid ColumnDefinitions="*, *" ColumnSpacing="20">
                <Button Grid.Column="0" 
                        Text="🔒 LOCK" 
                        TextColor="#FFFFFF" 
                        IsEnabled="{Binding LockButtonEnabled}"
                        BackgroundColor="#EF4444" 
                        FontSize="18" 
                        FontAttributes="Bold" 
                        CornerRadius="10" 
                        HeightRequest="65" 
                        Clicked="OnLockClicked" />

                <Button Grid.Column="1" 
                        Text="🔓 UNLOCK" 
                        TextColor="#FFFFFF" 
                        IsEnabled="{Binding UnLockButtonEnabled}"
                        BackgroundColor="#10B981" 
                        FontSize="18" 
                        FontAttributes="Bold" 
                        CornerRadius="10" 
                        HeightRequest="65" 
                        Clicked="OnUnlockClicked" />
            </Grid>
        </Border>

        <controls:BTDevicePicker IsVisible="{Binding BluetoothDevicePickerVisible}" Grid.Row="2" VerticalOptions="Fill" HorizontalOptions="Fill" />

        <Grid Grid.RowSpan="2" IsVisible="{Binding LayoutPasswordInitVisible}" ZIndex="100" BackgroundColor="#E6000000">
            <controls:InitMasterPassword VerticalOptions="Center" HorizontalOptions="Fill" />
        </Grid>
    </Grid>
</ContentPage>
