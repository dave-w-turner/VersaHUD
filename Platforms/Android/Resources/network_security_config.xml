<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- 🚀 UNLOCK LOCAL SUBNET: Allows unencrypted text transfers exclusively on your home network nodes -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">192.168.0.91</domain>
        <domain includeSubdomains="true">localhost</domain>
    </domain-config>
</network-security-config>
