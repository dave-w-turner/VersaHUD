<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VersaHUD.Controls.BTDevicePicker" 
             IsVisible="false"
             BackgroundColor="#B3000000"
             AbsoluteLayout.LayoutBounds="0,0,1,1"
             AbsoluteLayout.LayoutFlags="All">

    <Border VerticalOptions="End"
            HorizontalOptions="Fill"
            Margin="0"
            Padding="20,15,20,30"
            BackgroundColor="#1C1C1E"
            Stroke="Transparent"
            StrokeThickness="0"
            HeightRequest="420">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="16,16,0,0"/>
        </Border.StrokeShape>

        <Grid RowDefinitions="Auto, Auto, *" RowSpacing="12">
            <Grid Grid.Row="0" ColumnDefinitions="*, Auto">
                <Label Grid.Column="0"
                       Text="SELECT COCKPIT NODE"
                       TextColor="White"
                       FontAttributes="Bold"
                       FontSize="12"
                       VerticalOptions="Center"
                       CharacterSpacing="0.5"/>

                <Button Grid.Column="1"
                        Text="X CLOSE"
                        TextColor="#8E8E93"
                        FontSize="10"
                        FontAttributes="Bold"
                        BackgroundColor="Transparent"
                        BorderColor="Transparent"
                        Padding="5"
                        HeightRequest="30"
                        Clicked="OnClosePickerOverlayClicked"/>
            </Grid>

            <Button Grid.Row="1"
                    x:Name="btnOverlayRefreshScan"
                    Text="🔄 REFRESH DEVICE SCAN"
                    FontSize="10"
                    FontAttributes="Bold"
                    TextColor="White"
                    BackgroundColor="#3B82F6"
                    CornerRadius="8"
                    HeightRequest="36"
                    HorizontalOptions="Fill"
                    VerticalOptions="Center"
                    Clicked="OnRefreshScanClicked" />

            <Grid Grid.Row="2" RowDefinitions="*, Auto" RowSpacing="10">

                <CollectionView Grid.Row="0" 
                                x:Name="listBleDevices"
                                SelectionMode="Single"
                                SelectionChanged="OnBleDeviceSelected">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border BackgroundColor="#2D2D2D"
                                    Stroke="#3D3D3D" 
                                    StrokeThickness="1"
                                    Padding="15,10">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8"/>
                                </Border.StrokeShape>
                                <HorizontalStackLayout Spacing="15">
                                    <Label Text="📡" FontSize="20" VerticalOptions="Center"/>
                                    <VerticalStackLayout VerticalOptions="Center">
                                        <Label Text="{Binding Name}"
                                               TextColor="#FFFFFF"
                                               FontAttributes="Bold"
                                               FontSize="14"/>
                                        <Label Text="{Binding Id}"
                                               TextColor="#8E8E93"
                                               FontSize="11"/>
                                    </VerticalStackLayout>
                                </HorizontalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <ActivityIndicator Grid.Row="1" 
                                   x:Name="indicatorScanning"
                                   Color="#108981"
                                   HorizontalOptions="Center"
                                   HeightRequest="30"
                                   WidthRequest="30"
                                   IsRunning="False"
                                   IsVisible="False"/>
            </Grid>
        </Grid>
    </Border>
</ContentView>
    